//Modify this code to update the diagram

Coach
-
ID serial
name varchar(20)
  surname varchar(20)
  login varchar(10)
  password varchar(255)
  is_participate boolean

CoachSpecializationTypes
-
ID serial
name varchar(20)
HallID int FK > Hall.ID

CoachSpecialization
-
ID serial
SpecID int FK > CoachSpecializationTypes.ID
CoachID int FK > Coach.ID

CoachSchedule
-
ID serial
CoachID int FK > Coach.ID
date date
  start time
  stop time

Client
-
ID serial
name varchar(20)
  surname varchar(20)
  login varchar(10)
  password varchar(255)
  is_participate boolean

ClientDynamicTypes
-
ID serial
name varchar(30)
  unit varchar(20)

ClientDynamic
-
ID serial
ClientID int FK > Client.ID
DynamicTypeID int FK > ClientDynamicTypes.ID
value float
date Date

Admin
-
ID serial
name varchar(20)
  surname varchar(20)
  login varchar(10)
  password varchar(255)
  is_participate boolean

StandartTraining
-
ID serial
name varchar(50)
AdminID int FK > Admin.ID
CoachID int FK > Coach.ID
HallID int FK > Hall.ID
capacity int
  datetime timestamp
  duration float

Hall
-
ID serial
name varchar(30)

HallSchedule
-
ID serial
HallID int FK > Hall.ID
date date
  start time
  stop time

TrainingSigns
-
ID serial
ClientID int FK > Client.ID
StdTrainingID int FK > StandartTraining.ID

IndividualTraining
-
ID serial
CoachID int FK > Coach.ID
ClientID int FK > Client.ID
HallID int FK > Hall.ID
datetime timestamp
  duration float
  notes text


